import time
from pick import pick

# Beer list defined
options = ["Coors", "Budweiser", "Local IPA", "Pabst Blue Ribbon", "Heineken"]


def age_prompt():
    print("What is your age?")
    return(int(input("Enter your age: ")))

def check_name():
    name = input("What is your name? ")
    print(f"Welcome to the club, {name}! Enjoy your beer.")

def beer_prompt():
    print("Please choose your option from our menu (Use UP/DOWN arrows, press ENTER to select): ")
    option, index = pick(options, indicator="=>", default_index=0)
    print(f"You selected: {option} (Index: {index})")

def check_age(age):   
    if age >= 21:
        print("You may have a beer!")
        check_name() #This calls for the name function
        beer_prompt() #This calls for the beer list function
    else:
        print("You are too young, get the hell out!") 

def user_prompt_1():
    age = age_prompt()
    print(f"You entered: {age}")
    result = check_age(age)

def user_prompt_2():
    # first check the user's age
    age = age_prompt()
    print(f"You entered: {age}")
    check_age(age)

