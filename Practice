import time

def check_age(age):   
    if age >= 21:
        print("You may have a beer!")
    else:
        print("You are too young, get the hell out!") 

while (True):
    print("What is your age?")
    result = check_age(int(input("Enter your age: ")))
    print(result)
    time.sleep(1.0) #Delays the question by a second. 